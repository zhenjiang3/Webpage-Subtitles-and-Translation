# ===== apps/web 本地环境变量 =====
# 注：ASR / Translator 相关 Key 优先写在根目录 .env.local（monorepo 共享）
#     写在这里也生效（Next.js 会同时读 根.env.local 和 apps/web/.env.local，后者优先级高）

# 数据库：SQLite 文件存放在项目根 data/ 目录
DATABASE_URL="file:../../data/app.db"

# ========== 方案 C ⭐ 免费零 API（whisper.cpp + Xenova NLLB） ==========
# 一键下载：pnpm --filter @app/web setup:offline
# ASR_PROVIDER=whisper-cpp
# WHISPER_CLI_PATH=./tools/whisper/whisper-cli.exe
# WHISPER_MODEL_PATH=./tools/whisper/models/ggml-small.bin
# WHISPER_THREADS=8
# TRANSLATOR_PROVIDER=xenova-nllb
# XENOVA_CACHE_DIR=./.cache/xenova

# ---- Xenova 网络配置：解决 TypeError: fetch failed / 证书错误 ----
#  （代码里默认使用 hf-mirror.com，无需配置就能在中国跑；下面是覆盖/高级场景）
# ① 换 HuggingFace 镜像源：
# XENO_REMOTE_HOST=https://hf-mirror.com/
# XENO_REMOTE_HOST=https://hf-mirror.chuying.org/
# HF_ENDPOINT=https://hf-mirror.com/   # 同上，与常用工具链兼容变量
# ② 临时禁用 TLS 校验（本机开发：MITM 自签证书时使用）：
# HF_MIRROR_INSECURE=1
# ③ 统一代理（HTTP/HTTPS_PROXY 被 undici ProxyAgent 自动识别）：
# HTTPS_PROXY=http://127.0.0.1:7890
# ④ 强制纯本地模式（完全不走网络，需提前手动下载模型）：
# XENO_FORCE_LOCAL=1
# ⑤ 或推荐在 dev server 启动命令前：$env:NODE_OPTIONS="--use-system-ca"

# ========== 原默认（云端付费） ==========
# OPENAI_API_KEY=
# ASR_PROVIDER=openai-whisper
# DEEPL_API_KEY=
# TRANSLATOR_PROVIDER=deepl

# ========== DeepSeek LLM 翻译（V1 预留） ==========
# TRANSLATOR_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# ========== 存储 ==========
# UPLOAD_DIR=./data/uploads
# MAX_UPLOAD_BYTES=524288000
# MAX_DURATION_SEC=1800

# ========== FFmpeg 绝对路径（Windows 下若自检/抽音失败再填） ==========
#   PowerShell 查路径：
#     Get-Command ffmpeg  | Select-Object -ExpandProperty Source
#     Get-Command ffprobe | Select-Object -ExpandProperty Source
# FFMPEG_BIN_PATH=C:\FFmpeg\bin\ffmpeg.exe
# FFPROBE_BIN_PATH=C:\FFmpeg\bin\ffprobe.exe
