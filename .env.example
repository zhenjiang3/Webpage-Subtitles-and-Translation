# ===== 环境变量模板：复制为 .env.local 并填入真实值 =====

# ===== ASR 配置（二选一） =====
# 方案 A：OpenAI Whisper API（推荐，无需 GPU，按量付费）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASR_PROVIDER=openai-whisper

# 方案 B：本地 faster-whisper（可选，需 Python + 模型）
# ASR_PROVIDER=local-whisper
# WHISPER_MODEL_SIZE=medium

# ===== 翻译配置（二选一） =====
# 方案 A：DeepL Free（每月 50 万字符免费，V1 首选）
DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
TRANSLATOR_PROVIDER=deepl

# 方案 B：Google Cloud Translation（备用）
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
# TRANSLATOR_PROVIDER=google

# ===== 本地存储 =====
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=524288000
MAX_DURATION_SEC=1800

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
