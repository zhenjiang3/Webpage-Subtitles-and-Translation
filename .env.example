# ===== 环境变量模板：复制为 .env.local 并填入真实值 =====

# ===== ASR 配置（三选一，按是否付费排序） =====
# ————— 方案 C ⭐ 免费零 API：本地 whisper.cpp（C++ 预编译 + ggml-small.bin 487MB）
#   一键安装二进制和模型：pnpm --filter @app/web setup:offline
#   也可以手动：https://github.com/ggml-org/whisper.cpp/releases 下载 whisper-bin-x64.zip 解压
#                下载模型：https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin
ASR_PROVIDER=whisper-cpp
# WHISPER_CLI_PATH=./apps/web/tools/whisper/whisper-cli.exe
# WHISPER_MODEL_PATH=./apps/web/tools/whisper/models/ggml-small.bin
# WHISPER_THREADS=8                    # 可选，默认自动=min(8, max(4, CPU核数/2))

# ————— 方案 A（原默认）：OpenAI Whisper API（云端付费，$0.006/min，精度最高）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ASR_PROVIDER=openai-whisper

# ————— 方案 B：本地 faster-whisper（Python，V1 暂未接 provider，留占位）
# ASR_PROVIDER=local-whisper
# WHISPER_MODEL_SIZE=medium

# ===== 翻译配置（三选一） =====
# ————— 方案 C ⭐ 免费零 API：Xenova NLLB-200-600M（本地 ONNX，~900MB 模型首次自动下载）
#   覆盖 V1 三语种：中 ↔ 英 ↔ 日 全方向
TRANSLATOR_PROVIDER=xenova-nllb
# XENOVA_CACHE_DIR=./apps/web/.cache/xenova    # 可选：指定 NLLB 模型缓存目录

# ---- Xenova 网络配置：解决 TypeError: fetch failed / 证书错误 ----
# （代码里默认使用 hf-mirror.com，无需配置就能在中国跑；下面是覆盖/高级场景）
# ① 换 HuggingFace 镜像源：
# XENO_REMOTE_HOST=https://hf-mirror.com/
# XENO_REMOTE_HOST=https://hf-mirror.chuying.org/
# HF_ENDPOINT=https://hf-mirror.com/
# ② 临时禁用 TLS 校验（本机开发：MITM 自签证书时使用）：
# HF_MIRROR_INSECURE=1
# ③ 统一代理（HTTP/HTTPS_PROXY 被 undici ProxyAgent 自动识别）：
# HTTPS_PROXY=http://127.0.0.1:7890
# ④ 强制纯本地模式（完全不走网络，需提前手动下载模型）：
# XENO_FORCE_LOCAL=1
# ⑤ 推荐在 dev server 启动命令前：$env:NODE_OPTIONS="--use-system-ca"

# ————— 方案 A（原默认）：DeepL Free（每月 50 万字符免费）
# DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
# TRANSLATOR_PROVIDER=deepl

# ————— 方案 B：DeepSeek Chat LLM 翻译（V1 预留：provider 代码稍后加）
# TRANSLATOR_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# ————— 方案 D：Google Cloud Translation（预留）
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
# TRANSLATOR_PROVIDER=google

# ===== 本地存储 =====
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=524288000
MAX_DURATION_SEC=1800

# ===== FFmpeg（Windows 下若自检找不到，请取消注释并填入 Get-Command 输出的绝对路径） =====
#   PowerShell 查路径：Get-Command ffmpeg  | Select-Object -ExpandProperty Source
#   PowerShell 查路径：Get-Command ffprobe | Select-Object -ExpandProperty Source
# FFMPEG_BIN_PATH=C:\FFmpeg\bin\ffmpeg.exe
# FFPROBE_BIN_PATH=C:\FFmpeg\bin\ffprobe.exe

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
